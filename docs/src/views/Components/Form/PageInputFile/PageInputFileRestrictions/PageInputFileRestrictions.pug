aloha-example(
  :code-html="codeHtml"
  :code-js="codeJs"
  header="_A_INPUT_FILE_GROUP_RESTRICTIONS_HEADER_"
  description="_A_INPUT_FILE_GROUP_RESTRICTIONS_DESCRIPTION_"
  :props="['accept', 'accept-text', 'max-size', 'max-files', 'is-hint']"
)
  a-input-file(
    v-model="model"
    :is-dropzone="true"
    :is-multiple="true"
    :is-append="true"
    accept=".pdf,.docx,image/*"
    accept-text="_A_INPUT_FILE_EXAMPLE_ACCEPT_TEXT_"
    :max-size="1024 * 1024"
    :max-files="3"
    label="_A_INPUT_FILE_EXAMPLE_LABEL_"
    @reject="onReject"
  )
  div.a_mt_2 reject: {{ rejected }}
