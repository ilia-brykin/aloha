aloha-example(
  :code-html="codeHtml"
  :code-js="codeJs"
  header="_A_TOOLTIP_GROUP_TIME_OPEN_HEADER_"
  description="_A_TOOLTIP_GROUP_TIME_OPEN_DESCRIPTION_"
  :props="['time-open']"
)
  .a_d_flex.a_flex_wrap.a_gap_3
    a-tooltip(
      v-for="time in times"
      :key="time"
      :time-open="time"
    )
      a-button(
        class="a_btn a_btn_secondary"
        :text="`time-open: ${ time }`"
      )

      template(
        v-slot:title
      )
        span {{ time }} ms
