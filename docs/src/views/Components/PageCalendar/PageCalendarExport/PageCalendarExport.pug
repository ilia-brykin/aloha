aloha-example(
  :code-html="codeHtml"
  :code-js="codeJs"
  header="_A_CALENDAR_EXPORT_HEADER_"
  description="_A_CALENDAR_EXPORT_DESCRIPTION_"
)
  .a_d_flex.a_gap_2.a_mb_3
    a-button(
      class="a_btn a_btn_primary"
      text="_A_CALENDAR_EXPORT_DOWNLOAD_"
      @click="download"
    )
    a-button(
      class="a_btn a_btn_outline_secondary"
      text="_A_CALENDAR_EXPORT_PREVIEW_"
      @click="showPreview"
    )
  a-calendar(
    ref="calendarRef"
    :events="events"
  )
  pre.a_mt_3.a_mb_0(
    v-if="ics"
  ) {{ ics }}
