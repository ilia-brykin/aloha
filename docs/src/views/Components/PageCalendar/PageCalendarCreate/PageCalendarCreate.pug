aloha-example(
  :code-html="codeHtml"
  :code-js="codeJs"
  header="_A_CALENDAR_CREATE_HEADER_"
  description="_A_CALENDAR_CREATE_DESCRIPTION_"
)
  a-button(
    class="a_btn a_btn_primary a_mb_3"
    text="_A_CALENDAR_CREATE_BTN_"
    @click="openModalNew"
  )
  a-calendar(
    :events="events"
    @day-click="onDayClick"
    @event-click="onEventClick"
  )
  a-modal-form(
    v-if="isModalVisible"
    v-model="model"
    :data-form="dataForm"
    :header-text="headerText"
    :close="closeModal"
    :save="save"
    :disabled-save="isSaveDisabled"
    class-columns="a_columns a_columns_count_12 a_columns_gap_3"
    class-column-default="a_column a_column_6 a_column_12_touch"
  )
    template(
      v-if="isEditing"
      v-slot:modalFooterAppend
    )
      a-button(
        class="a_btn a_btn_outline_danger"
        text="_A_CALENDAR_CREATE_DELETE_"
        @click="deleteEvent"
      )
