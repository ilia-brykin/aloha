aloha-example(
  :code-html="codeHtmlBasic"
  :code-js="codeJsBasic"
  header="_A_UI_URL_TEMPLATE_BASIC_HEADER_"
  description="_A_UI_URL_TEMPLATE_BASIC_DESCRIPTION_"
  :props="['url', 'url-template-data']"
)
  a-select(
    v-model="templateDataBasic.file"
    :data="sources"
    :translate-data="true"
    key-id="id"
    key-label="label"
    label="_A_UI_URL_TEMPLATE_SOURCE_"
    type="select"
  )
  a-checkbox(
    v-model="modelBasic"
    :url="urlBasic"
    :url-template-data="templateDataBasic"
    key-id="id"
    key-label="label"
    label="_A_UI_URL_TEMPLATE_OPTIONS_"
  )
  div model: {{ modelBasic }}

aloha-example(
  :code-html="codeHtmlReactive"
  :code-js="codeJsReactive"
  header="_A_UI_URL_TEMPLATE_REACTIVE_HEADER_"
  description="_A_UI_URL_TEMPLATE_REACTIVE_DESCRIPTION_"
  :props="['url', 'url-template-data']"
)
  a-select(
    v-model="templateDataReactive.source.file"
    :data="sources"
    :translate-data="true"
    key-id="id"
    key-label="label"
    label="_A_UI_URL_TEMPLATE_SOURCE_"
    type="select"
  )
  a-input(
    v-model="templateDataReactive.note"
    label="_A_UI_URL_TEMPLATE_NOTE_"
  )
  a-checkbox(
    v-model="modelReactive"
    :url="urlReactive"
    :url-template-data="templateDataReactive"
    key-id="id"
    key-label="label"
    label="_A_UI_URL_TEMPLATE_OPTIONS_"
  )
  div model: {{ modelReactive }}
