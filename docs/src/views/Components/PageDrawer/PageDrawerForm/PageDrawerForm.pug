aloha-example(
  :code-html="codeHtml"
  :code-js="codeJs"
  header="_A_DRAWER_FORM_HEADER_"
  description="_A_DRAWER_FORM_DESCRIPTION_"
  :props="['save', 'is-footer-sticky']"
)
  a-button(
    id="btn_drawer_form"
    class="a_btn a_btn_primary"
    text="_A_DRAWER_BTN_EDIT_"
    @click="openDrawer"
  )

  a-drawer(
    v-if="isDrawerVisible"
    selector-close-ids="btn_drawer_form"
    :close="closeDrawer"
    :save="save"
    :is-footer-sticky="true"
    header-text="_A_DRAWER_FORM_HEADER_"
  )
    template(
      v-slot:modalBody
    )
      a-form(
        v-model="modelLocal"
        :data="dataForm"
      )

  pre.a_mt_3 {{ model }}
