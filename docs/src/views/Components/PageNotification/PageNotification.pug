aloha-page(
  :page-title="pageTitle"
)
  template(
    v-slot:body
  )
    a-translation(
      tag="p"
      html="_A_NOTIFICATION_COMPONENT_DESCRIPTION_"
    )

    page-notification-basic

    page-notification-title

    page-notification-actions

    page-notification-placement

    page-notification-progress

    page-notification-deduplicate

    page-notification-remove

    page-notification-own-component

    aloha-table-props(
      :data="dataProps"
    )

    aloha-table-props(
      table-label="_A_NOTIFICATION_FUNCTIONS_HEADER_"
      :data="dataFunctions"
      :columns="['name', 'description']"
    )

    aloha-table-props(
      table-label="_A_NOTIFICATION_OPTIONS_HEADER_"
      :data="dataOptions"
      :columns="['name', 'type', 'default', 'description']"
    )

    aloha-table-css-vars(
      files="utils/notification"
    )
