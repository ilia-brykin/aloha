aloha-example(
  :code-html="codeHtml"
  :code-js="codeJs"
  header="_A_TREE_GROUP_CHECK_STRICTLY_HEADER_"
  description="_A_TREE_GROUP_CHECK_STRICTLY_DESCRIPTION_"
  :props="['is-check-strictly']"
)
  a-tree(
    v-model="checked"
