aloha-example(
  :code-html="codeHtml"
  :code-js="codeJs"
  header="_A_PAGINATION_PAGES_GROUP_SLOTS_HEADER_"
  description="_A_PAGINATION_PAGES_GROUP_SLOTS_DESCRIPTION_"
)
  a-pagination-pages(
    v-model:page="page"
    :limit="10"
    :total-count="87"
    mode="short"
  )
    template(v-slot:previous)
      span ← Back
    template(v-slot:next)
      span Next →
  a-pagination-pages.a_mt_3(
    v-model:page="page"
    :limit="10"
    :total-count="87"
  )
    template(v-slot:page="{ page: number, isActive }")
      strong(v-if="isActive") [{{ number }}]
      span(v-else) {{ number }}
