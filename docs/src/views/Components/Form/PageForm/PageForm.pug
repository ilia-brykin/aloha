aloha-page(
  :page-title="pageTitle"
)
  template(
    v-slot:body
  )
    a-translation(
      tag="p"
      html="_A_FORM_COMPONENT_DESCRIPTION_"
    )

    aloha-form-types

    page-form-basic

    page-form-dependencies

    page-form-validation-readonly

    page-form-events-slots

    aloha-table-props(
      :data="dataProps"
    )

    aloha-table-props(
      table-label="Emits"
      :data="dataEvents"
      :columns="['name', 'type', 'description']"
    )

    aloha-table-props(
      table-label="Slots"
      :data="dataSlots"
      :columns="['name', 'description']"
    )
