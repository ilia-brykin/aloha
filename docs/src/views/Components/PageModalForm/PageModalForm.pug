aloha-page(
  :page-title="pageTitle"
)
  template(
    v-slot:body
  )
    a-translation(
      tag="p"
      html="_A_MODAL_FORM_COMPONENT_DESCRIPTION_"
    )

    page-modal-form-columns

    aloha-table-props(
      :data="dataProps"
    )

    aloha-table-props(
      table-label="Emits"
      :data="dataEvents"
      :columns="['name', 'type', 'description']"
    )

    aloha-table-props(
      table-label="Slots"
      :data="dataSlots"
      :columns="['name', 'description']"
    )
