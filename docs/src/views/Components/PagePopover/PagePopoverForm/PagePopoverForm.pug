aloha-example(
  :code-html="codeHtml"
  :code-js="codeJs"
  header="_A_POPOVER_GROUP_FORM_HEADER_"
  description="_A_POPOVER_GROUP_FORM_DESCRIPTION_"
)
  a-popover(
    button-text="_A_POPOVER_EXAMPLE_RENAME_"
    header="_A_POPOVER_EXAMPLE_RENAME_"
  )
    a-input(
      v-model="name"
      label="_A_POPOVER_EXAMPLE_NAME_"
    )
    template(v-slot:footer="{ close }")
      a-button(
        class="a_btn a_btn_secondary"
        text="_A_POPOVER_EXAMPLE_CANCEL_"
        @click="close"
      )
      a-button(
        class="a_btn a_btn_primary"
        text="_A_POPOVER_EXAMPLE_SAVE_"
        @click="save(close)"
      )
  p.a_mt_3(
    v-if="saved"
  ) {{ saved }}
