aloha-page(
  :page-title="pageTitle"
)
  template(
    v-slot:body
  )
    a-translation(
      tag="p"
      html="_A_ACCORDION_COMPONENT_DESCRIPTION_"
    )

    page-accordion-basic

    page-accordion-always-open

    page-accordion-one-item-always-open

    page-accordion-v-model

    page-accordion-children

    page-accordion-slots

    page-accordion-disabled

    aloha-table-props(
      :data="dataProps"
    )

    aloha-table-props(
      table-label="Slots"
      :data="dataSlots"
      :columns="['name', 'description']"
    )

    aloha-table-props(
      table-label="Events"
      :data="dataEvents"
      :columns="['name', 'type', 'description']"
    )

    aloha-table-css-vars(
      files="utils/accordion"
    )
