{
  "name": "aloha-vue",
  "version": "3.0.0-alpha.2",
  "description": "Accessible Vue 3 component library: 80+ components (table with filters and pagination, form builder, select, datepicker, modal, wizard, tree, calendar…), utility CSS, formatting filters and translations in 11 languages. Ships with TypeScript types and docs for AI coding agents (AGENTS.md).",
  "keywords": [
    "vue",
    "vue3",
    "vue-components",
    "component-library",
    "ui-library",
    "accessibility",
    "accessible",
    "a11y",
    "wcag",
    "datatable",
    "table",
    "form-builder",
    "forms",
    "datepicker",
    "select",
    "modal",
    "i18n",
    "typescript",
    "ai-agents",
    "aloha-vue"
  ],
  "homepage": "https://ilia-brykin.github.io/aloha/",
  "bugs": {
    "url": "https://github.com/ilia-brykin/aloha/issues",
    "email": "aloha.vue@gmail.com"
  },
  "license": "MIT",
  "author": {
    "name": "Ilia Brykin",
    "email": "brykin.ilia@gmail.com"
  },
  "contributors": [
    {
      "name": "Emilija Zdilar"
    },
    {
      "name": "Hafedh Souissi"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ilia-brykin/aloha.git"
  },
  "scripts": {
    "build": "npm run lint && npm test && npm run build-types && npm run build-llms && npm run build-lib && npm run build-styles",
    "build-lib": "vite build --config vite.lib.config.mjs",
    "build-styles": "sass scss/aloha-vue.scss dist/aloha-vue.css",
    "build-llms": "cd docs && node scripts/build-llms.mjs",
    "build-types": "node scripts/build-types.mjs",
    "pub": "npm publish --scope=@npm",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src utilsTests *.mjs"
  },
  "main": "dist/aloha-vue.umd.js",
  "module": "dist/aloha-vue.es.js",
  "types": "types/aloha-vue.d.ts",
  "web-types": "web-types.json",
  "exports": {
    ".": {
      "types": "./types/aloha-vue.d.ts",
      "import": "./dist/aloha-vue.es.js",
      "require": "./dist/aloha-vue.umd.js"
    },
    "./dist/*": "./dist/*",
    "./scss/*": "./scss/*",
    "./package.json": "./package.json",
    "./*": "./dist/*"
  },
  "dependencies": {
    "@floating-ui/vue": "2.0.1",
    "axios": "1.20.0",
    "dompurify": "3.4.17",
    "fecha": "4.2.3",
    "lodash-es": "4.18.1",
    "moment": "2.31.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@stylistic/eslint-plugin": "5.10.0",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/test-utils": "2.4.11",
    "eslint": "9.39.5",
    "eslint-plugin-import-group": "3.1.0",
    "eslint-plugin-vue": "9.33.0",
    "eslint-plugin-vue-pug": "0.6.2",
    "globals": "17.13.0",
    "jsdom": "28.1.0",
    "sass": "1.105.1",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "vue": "3.5.43"
  },
  "files": [
    "AGENTS.md",
    "CHANGELOG.md",
    "dist",
    "LICENSE",
    "llms",
    "package.json",
    "README.md",
    "scss",
    "src",
    "types",
    "web-types.json"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
