aloha-page(
  :page-title="pageTitle"
)
  template(
    v-slot:body
  )
    a-translation(
      tag="p"
      html="_A_CAROUSEL_COMPONENT_DESCRIPTION_"
    )

    page-carousel-basic

    page-carousel-model

    page-carousel-autoplay

    page-carousel-loop

    page-carousel-transition

    page-carousel-card

    page-carousel-vertical

    page-carousel-labels

    page-carousel-aria-disabled

    page-carousel-arrows-trigger

    page-carousel-arrows-placement

    page-carousel-indicators-limit

    page-carousel-indicators-auto-limit

    page-carousel-indicators-type

    page-carousel-emits

    page-carousel-delete-active-slide

    aloha-table-props(
      :data="dataProps"
    )

    aloha-table-props(
      table-label="Slots"
      :data="dataSlots"
      :columns="['name', 'description']"
    )

    aloha-table-props(
      table-label="Events"
      :data="dataEvents"
      :columns="['name', 'type', 'description']"
    )

    aloha-table-props(
      table-label="Exposes"
      :data="dataExposes"
      :columns="['name', 'type', 'description']"
    )

    aloha-table-translate(
      :data="dataTranslate"
    )

    aloha-table-css-vars(
      files="components/ACarousel"
    )
