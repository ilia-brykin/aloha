aloha-example(
  :code-html="codeHtml"
  :code-js="codeJs"
  header="_A_CAROUSEL_GROUP_CARD_HEADER_"
  description="_A_CAROUSEL_GROUP_CARD_DESCRIPTION_"
  :props="['type', 'card-scale']"
)
  .a_columns.a_columns_count_12
    .a_column.a_column_12_touch.a_column_8
      a-carousel(
        :data="data"
        aria-label="_A_CAROUSEL_COMPONENT_BALLS_ARIA_LABEL_"
        key-id="id"
        type="card"
      )
        template(
          v-slot:item="{ item }"
        )
          img.a_height_auto.a_width_100(
            :src="item.src"
            :alt="item.alt"
          )
    .a_column.a_column_12_touch.a_column_4
      a-translation(
        tag="h3"
        html="_A_CAROUSEL_COMPONENT_CARD_VERTICAL_"
      )
      a-carousel(
        :data="data"
        :card-scale="0.7"
        aria-label="_A_CAROUSEL_COMPONENT_BALLS_ARIA_LABEL_"
        direction="vertical"
        height="24rem"
        key-id="id"
        type="card"
      )
        template(
          v-slot:item="{ item }"
        )
          img.a_height_auto.a_width_100(
            :src="item.src"
            :alt="item.alt"
          )
