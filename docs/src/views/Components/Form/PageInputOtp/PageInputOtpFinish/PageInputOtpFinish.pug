aloha-example(
  :code-html="codeHtml"
  :code-js="codeJs"
  header="_A_INPUT_OTP_GROUP_FINISH_HEADER_"
  description="_A_INPUT_OTP_GROUP_FINISH_DESCRIPTION_"
  :props="['finish', 'errors']"
)
  a-input-otp(
    ref="otpRef"
    v-model="model"
    :errors="errors"
    label="_A_INPUT_OTP_EXAMPLE_LABEL_"
    @finish="onFinish"
    @update:model-value="onUpdateModel"
  )
  a-alert.a_mt_3(
    :is-visible="isSuccess"
    type="success"
    text="_A_INPUT_OTP_EXAMPLE_SUCCESS_"
  )
