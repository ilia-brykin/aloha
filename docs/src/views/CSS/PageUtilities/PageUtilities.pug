aloha-page(
  page-title="_A_UTILITIES_PAGE_NAME_"
  page-title-h1="_A_UTILITIES_PAGE_NAME_"
)
  template(
    v-slot:body
  )
    aloha-example(
      :code-html="codeFocus"
      header="_A_UTILITIES_FOCUS_NAME_"
      description="_A_UTILITIES_FOCUS_DESCRIPTION_"
    )
      .a_d_flex.a_gap_3.a_flex_wrap
        .a_focus_ring.a_p_3.a_border(
          tabindex="0"
        )
          code a_focus_ring
        .a_focus_ring_inset.a_p_3.a_border(
          tabindex="0"
        )
          code a_focus_ring_inset

    aloha-example(
      :code-html="codeText"
      header="_A_UTILITIES_TEXT_NAME_"
      description="_A_UTILITIES_TEXT_DESCRIPTION_"
    )
      p.a_text_muted a_text_muted
      p.a_text_emphasis a_text_emphasis

    aloha-example(
      :code-html="codeShadow"
      header="_A_UTILITIES_SHADOW_NAME_"
      description="_A_UTILITIES_SHADOW_DESCRIPTION_"
    )
      .a_d_flex.a_gap_4.a_flex_wrap.a_p_2
        .a_p_3.a_border(
          v-for="value in shadows"
          style="background: var(--a_color_surface); border-radius: var(--a_border_radius);"
          :key="value"
          :class="`a_shadow_${ value }`"
        )
          code a_shadow_{{ value }}

    aloha-example(
      :code-html="codeRoundedCircle"
      header="_A_UTILITIES_ROUNDED_CIRCLE_NAME_"
      description="_A_UTILITIES_ROUNDED_CIRCLE_DESCRIPTION_"
    )
      .a_d_flex.a_gap_3.a_flex_wrap.a_align_items_center
        .a_rounded_circle.a_bg_primary.a_color_white.a_d_flex.a_align_items_center.a_justify_content_center(
          style="width: 3rem; height: 3rem;"
        ) AB
        .a_rounded_circle.a_bg_success(
          style="width: .75rem; height: .75rem;"
        )
        code a_rounded_circle

    aloha-example(
      :code-html="codeVisibility"
      header="_A_UTILITIES_VISIBILITY_NAME_"
      description="_A_UTILITIES_VISIBILITY_DESCRIPTION_"
    )
      .a_d_flex.a_gap_2.a_flex_wrap
        .a_p_2.a_border 1
        .a_p_2.a_border.a_invisible 2: a_invisible
        .a_p_2.a_border 3
      .a_d_flex.a_gap_2.a_flex_wrap.a_mt_2
        .a_p_2.a_border 1
        .a_p_2.a_border.a_d_none 2: a_d_none
        .a_p_2.a_border 3

    aloha-example(
      :code-html="codeCursor"
      header="_A_UTILITIES_CURSOR_NAME_"
      description="_A_UTILITIES_CURSOR_DESCRIPTION_"
    )
      .a_d_flex.a_gap_2.a_flex_wrap
        .a_p_2.a_border(
          v-for="value in cursors"
          :key="value"
          :class="`a_cursor_${ value }`"
        )
          code a_cursor_{{ value }}

    aloha-example(
      :code-html="codePointerEvents"
      header="_A_UTILITIES_POINTER_EVENTS_NAME_"
      description="_A_UTILITIES_POINTER_EVENTS_DESCRIPTION_"
    )
      .a_d_flex.a_gap_3.a_flex_wrap.a_align_items_center
        a.a_pointer_events_none(
          href="#"
          tabindex="-1"
          aria-disabled="true"
        ) a_pointer_events_none
        .a_pointer_events_none
          a.a_pointer_events_auto(
            href="#"
            @click.prevent
          ) a_pointer_events_auto

    aloha-example(
      :code-html="codeTextSelect"
      header="_A_UTILITIES_TEXT_SELECT_NAME_"
      description="_A_UTILITIES_TEXT_SELECT_DESCRIPTION_"
    )
      div
        code.a_color_danger.a_mr_2 .a_text_select_all
        span.a_text_select_all.a_text_monospace 3f9a1c7e-42b0-4d1e-9c55
      div
        code.a_color_danger.a_mr_2 .a_text_select_none
        span.a_text_select_none Text

    aloha-example(
      :code-html="codeOpacity"
      header="_A_UTILITIES_OPACITY_NAME_"
      description="_A_UTILITIES_OPACITY_DESCRIPTION_"
    )
      .a_d_flex.a_gap_2.a_flex_wrap
        .a_bg_primary.a_color_white.a_p_2(
          v-for="value in opacities"
          :key="value"
          :class="`a_opacity_${ value }`"
        ) a_opacity_{{ value }}

    aloha-example(
      :code-html="codeOrder"
      header="_A_UTILITIES_ORDER_NAME_"
      description="_A_UTILITIES_ORDER_DESCRIPTION_"
    )
      .a_d_flex.a_gap_2.a_flex_wrap
        .a_order_last.a_p_2.a_border 1: a_order_last
        .a_order_2.a_p_2.a_border 2: a_order_2
        .a_order_first.a_p_2.a_border 3: a_order_first
        .a_order_1.a_p_2.a_border 4: a_order_1

    aloha-example(
      :code-html="codeZIndex"
      header="_A_UTILITIES_Z_INDEX_NAME_"
      description="_A_UTILITIES_Z_INDEX_DESCRIPTION_"
    )
      table.aloha_table_properties
        thead
          tr
            th(
              scope="col"
            )
              a-translation(
                html="_TXT_CLASS_"
                tag="span"
              )
            th(
              scope="col"
            )
              a-translation(
                html="_A_TABLE_VALUES_"
                tag="span"
              )
        tbody
          tr(
            v-for="row in zIndexLayers"
            :key="row.className"
          )
            td
              code {{ row.className }}
            td
              code z-index: {{ row.value }}
          tr
            td
              code a_z_index_0 … a_z_index_3, a_z_index_auto
            td
              code z-index: 0 … 3, auto

    aloha-example(
      :code-html="codePrint"
      header="_A_UTILITIES_PRINT_NAME_"
      description="_A_UTILITIES_PRINT_DESCRIPTION_"
    )
      p.a_print_none
        code a_print_none
      p.a_d_none.a_print_block
        code a_print_block
