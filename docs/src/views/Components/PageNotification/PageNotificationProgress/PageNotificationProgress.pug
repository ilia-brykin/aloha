aloha-example(
  :code-html="codeHtml"
  :code-js="codeJs"
  header="_A_NOTIFICATION_PROGRESS_HEADER_"
  description="_A_NOTIFICATION_PROGRESS_DESCRIPTION_"
  :props="['has-progress']"
)
  a-button(
    class="a_btn a_btn_primary"
    text="_A_NOTIFICATION_EXAMPLE_SHOW_BTN_"
