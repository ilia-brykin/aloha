aloha-example(
  :code-html="codeHtml"
  :code-js="codeJs"
  header="_A_COLOR_PICKER_GROUP_COLOR_FORMAT_HEADER_"
  description="_A_COLOR_PICKER_GROUP_COLOR_FORMAT_DESCRIPTION_"
  :props="['color-formats']"
)
  a-color-picker(
    v-model="model"
    label="hex, rgb, hsl, hsv"
    :color-formats="['hex', 'rgb', 'hsl', 'hsv']"
    :show-alpha="true"
  )
  div.a_mb_3 model: {{ model }}
  a-color-picker(
    v-model="modelRgb"
    color-formats="rgb"
    label="rgb"
  )
  div model: {{ modelRgb }}
